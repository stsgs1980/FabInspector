{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "emitDeclarationOnly": false
  },
  "include": [
    "*.ts",
    "*.tsx",
    "plugins/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "cli",
    "scripts",
    "eslint.config.mjs",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
